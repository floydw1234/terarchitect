# Terarchitect — environment variables
# Copy to .env and set values. Restart the backend after changes.
#
# Who needs what:
#   Backend: needs backend-owned vars (GitHub token for UI actions, embedding +
#     memory LLM config, and TERARCHITECT_WORKER_API_KEY if worker auth is enabled).
#   Coordinator: needs TERARCHITECT_API_URL, TERARCHITECT_WORKER_API_KEY (if enabled),
#     MAX_CONCURRENT_AGENTS, AGENT_IMAGE, POLL_INTERVAL_SEC, and optionally
#     COORDINATOR_STATE_DIR / AGENT_DOCKER_MODE / DOCKER_NETWORK, etc.
#   Agent runtime config (Director/Worker/Codex or other worker URLs+keys) should be provided in
#     the coordinator environment; coordinator forwards those vars into agent runs.

# -----------------------------------------------------------------------------
# GitHub (required for agent pushes, PRs, and UI PR polling/approve/merge)
# -----------------------------------------------------------------------------
# Classic PAT with repo scope. Also accepted: GITHUB_TOKEN, GH_TOKEN, GITHUB_AGENT_TOKEN
github_agent_token=

# Git identity for agent commits and GitHub actions
GIT_USER_NAME=
GIT_USER_EMAIL=

# -----------------------------------------------------------------------------
# Director LLM (orchestrates the run: assesses progress, decides next steps)
# -----------------------------------------------------------------------------
# Known providers (DIRECTOR_LLM_URL auto-inferred when set):
#   openai | anthropic | groq | together | mistral | perplexity |
#   deepseek | xai | fireworks | google | gemini
# Set DIRECTOR_LLM_URL only for custom/self-hosted endpoints.
DIRECTOR_PROVIDER=custom
DIRECTOR_LLM_URL=https://openrouter.ai/api
DIRECTOR_MODEL=google/gemini-2.5-flash-lite
# For the default OpenRouter setup, set OPENROUTER_API_KEY and leave DIRECTOR_API_KEY blank.
DIRECTOR_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Worker (runs inside the agent container)
# -----------------------------------------------------------------------------
# codex = Codex CLI (preferred default for implementation-heavy work)
# opencode = OpenCode HTTP LLM; claude-code = Claude Code CLI headless
WORKER_MODE=codex
WORKER_LLM_URL=
WORKER_MODEL=
WORKER_API_KEY=
WORKER_TIMEOUT_SEC=3600
# Optional host Codex config directory mounted into the coordinator container for WORKER_MODE=codex.
# Leave blank/default for local development; point to a dedicated service account config for hosted installs.
CODEX_CONFIG_DIR=${HOME}/.codex
# Extra tools appended to the claude-code --allowedTools list (comma-separated).
# Use this to add MCP tools e.g. "mcp__brave__search,mcp__github__create_issue"
CLAUDE_CODE_EXTRA_TOOLS=

# -----------------------------------------------------------------------------
# Embeddings (ticket/graph search and HippoRAG memory)
# -----------------------------------------------------------------------------
# openai = OpenAI SDK; custom = use EMBEDDING_SERVICE_URL
EMBEDDING_PROVIDER=openai
EMBEDDING_SERVICE_URL=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# For OpenAI embeddings; also used as fallback for memory LLM. OPENAI_API_KEY is also read.
openai_api_key=

# -----------------------------------------------------------------------------
# Frontend LLM (optional; used for "Generate from Repo" graph generation)
# Falls back to DIRECTOR_* settings when blank.
# -----------------------------------------------------------------------------
FRONTEND_LLM_URL=
FRONTEND_LLM_MODEL=
FRONTEND_LLM_API_KEY=

# -----------------------------------------------------------------------------
# Memory / HippoRAG LLM (optional; defaults to Director LLM when blank)
# -----------------------------------------------------------------------------
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=
MEMORY_EMBEDDING_BASE_URL=

# -----------------------------------------------------------------------------
# Coordinator (set in coordinator env; re-read each poll)
# -----------------------------------------------------------------------------
MAX_CONCURRENT_AGENTS=1

# -----------------------------------------------------------------------------
# Worker API auth (coordinator and agent call /api/worker/*)
# -----------------------------------------------------------------------------
# If set, coordinator and agent must send Authorization: Bearer <key>. Leave blank for no auth (dev).
TERARCHITECT_WORKER_API_KEY=

# -----------------------------------------------------------------------------
# Agent container (optional overrides; coordinator passes these from backend env)
# -----------------------------------------------------------------------------
# OpenCode server URL inside the container is only needed for WORKER_MODE=opencode; set here to override.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# -----------------------------------------------------------------------------
# AgentHub / Swarm mode (optional; only needed when git_mode = "swarm")
# -----------------------------------------------------------------------------
# URL of the agenthub server from inside docker-compose services
AGENTHUB_URL=http://agenthub:8080
# Registered AgentHub agent API key for backend/coordinator service calls.
# Set the real key in the ignored root .env file after `ah join`.
AGENTHUB_API_KEY=
# Admin key for the agenthub server (used by docker-compose agenthub service)
AGENTHUB_ADMIN_KEY=changeme
# Shared git branch all swarm agents work on (default: swarm). Never touches main/master.
AGENTHUB_BRANCH=swarm

# -----------------------------------------------------------------------------
# Debug
# -----------------------------------------------------------------------------
# 1 = verbose Director logs; 0 = quiet
MIDDLE_AGENT_DEBUG=1
